{
  "name": "@arifszn/gitprofile",
  "description": "Create an automatic portfolio based on GitHub profile",
  "version": "3.1.0",
  "type": "module",
  "license": "MIT",
  "author": "arifszn",
  "repository": {
    "type": "git",
    "url": "https://github.com/arifszn/gitprofile.git"
  },
  "bugs": {
    "url": "https://github.com/arifszn/gitprofile/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "bun run lint:eslint && bun run lint:format",
    "lint:fix": "bun run lint:eslint:fix && bun run lint:format:fix",
    "lint:eslint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:format": "prettier --check \"./**/*.{js,jsx,ts,tsx,mjs,cjs,css,md,json,html,yml,yaml}\"",
    "lint:format:fix": "prettier --write \"./**/*.{js,jsx,ts,tsx,mjs,cjs,css,md,json,html,yml,yaml}\"",
    "prettier": "bun run lint:format",
    "prettier:fix": "bun run lint:format:fix",
    "preview": "vite preview"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^6.0.2",
    "axios": "^1.16.1",
    "date-fns": "^4.1.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "react-helmet-async": "^3.0.0",
    "react-hotjar": "^6.3.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.13",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "keywords": [
    "git-profile",
    "gitprofile",
    "gitportfolio",
    "personal-site",
    "template",
    "portfolio",
    "resume",
    "cv",
    "personal-website",
    "portfolio-website",
    "portfolio-site",
    "portfolio-template",
    "portfolio-page",
    "developer-portfolio",
    "portfolio-project",
    "github-portfolio",
    "tailwind-portfolio",
    "vite-portfolio",
    "projects",
    "open-source",
    "git",
    "react-portfolio",
    "github",
    "github-page",
    "github-pages",
    "github-portfolio",
    "vite-portfolio",
    "academic-portfolio",
    "github-api"
  ],
  "private": true
}
